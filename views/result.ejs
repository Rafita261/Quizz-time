<%- include('partials/head', {settings}) %>
<section class="result-card"><div class="trophy">🏆</div><span class="eyebrow">GAME COMPLETE</span><h1>Well done, <span><%= player.nickname %></span>!</h1><p>You’ve finished the quiz. Here are your results.</p><div class="result-stats"><div><strong><%= player.answers.filter(a=>a.correct).length %>/<%= player.answers.length %></strong><small>Correct answers</small></div><div><strong><%= player.score %></strong><small>Final score</small></div><div><strong>#<%= position %></strong><small>Leaderboard</small></div></div><div class="result-actions"><a class="btn btn-primary" href="/leaderboard">View leaderboard →</a><a class="btn btn-outline" href="/join">Play again</a></div><p class="muted">Your score includes correct answers and any speed bonuses.</p></section>
<%- include('partials/foot') %>