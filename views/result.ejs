<%- include('partials/head', {settings}) %>
<section class="result-card"><div class="trophy">🏆</div><span class="eyebrow">PARTIE TERMINÉE</span><h1>Bravo, <span><%= player.nickname %></span> !</h1><p>Tu as terminé le quiz. Voici ton résultat.</p><div class="result-stats"><div><strong><%= player.answers.filter(a=>a.correct).length %>/<%= player.answers.length %></strong><small>Bonnes réponses</small></div><div><strong><%= player.score %></strong><small>Score final</small></div><div><strong>#<%= position %></strong><small>Classement</small></div></div><div class="result-actions"><a class="btn btn-primary" href="/leaderboard">Voir le classement →</a><a class="btn btn-outline" href="/join">Rejouer</a></div><p class="muted">Le score comprend les bonnes réponses et les éventuels bonus de rapidité.</p></section>
<%- include('partials/foot') %>