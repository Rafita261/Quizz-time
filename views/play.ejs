<%- include('partials/head', {settings}) %>
<section class="quiz-top"><div><span class="eyebrow">JOUEUR · <%= player.nickname %></span><h1>Question <%= index %> <small>/ <%= total %></small></h1></div><div class="timer-pill">◷ <strong id="timer"><%= question.seconds %></strong><span>sec</span></div></section>
<div class="progress"><span style="width:<%= Math.round((index-1)/total*100) %>%"></span></div>
<section class="question-card"><div class="question-meta"><span class="type-pill"><%= question.type === 'tf' ? 'VRAI / FAUX' : 'QCM' %></span><span><%= question.points %> pts + bonus vitesse</span></div><h2><%= question.text %></h2><form id="answerForm" action="/answer" method="post"><input type="hidden" name="questionId" value="<%= question.id %>"><input type="hidden" id="elapsedSeconds" name="elapsedSeconds" value="0"><div class="answer-grid <%= question.type === 'tf' ? 'tf-grid' : '' %>"><% question.options.forEach((option, i) => { %><label class="answer-option"><input type="radio" name="answer" value="<%= option %>" required><span class="letter"><%= String.fromCharCode(65+i) %></span><span><%= option %></span><span class="radio-dot"></span></label><% }) %></div><button class="btn btn-primary full submit-answer" type="submit">Valider ma réponse →</button></form></section>
<script>
(()=>{let remaining=<%= question.seconds %>, elapsed=0;const timer=document.getElementById('timer'), hidden=document.getElementById('elapsedSeconds'), form=document.getElementById('answerForm');const tick=()=>{timer.textContent=remaining;timer.closest('.timer-pill').classList.toggle('urgent',remaining<=5);if(remaining<=0){hidden.value=elapsed;form.querySelectorAll('input[type=radio]').forEach(x=>x.disabled=true);if(!form.querySelector('input[name=answer]:checked')){const x=document.createElement('input');x.type='hidden';x.name='answer';x.value='';form.appendChild(x)}form.submit();return}remaining--;elapsed++;hidden.value=elapsed};setInterval(tick,1000);form.addEventListener('submit',()=>{hidden.value=elapsed;form.querySelectorAll('button').forEach(b=>b.disabled=true)});})();
</script>
<%- include('partials/foot') %>