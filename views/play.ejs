<%- include('partials/head', {settings}) %>
<% if (quizState === 'lobby' || quizState === 'countdown') { %>
<section class="question-card waiting-card" style="text-align:center;max-width:680px;margin:55px auto;padding:45px 30px">
  <div class="avatar">✳</div><span class="eyebrow">WAITING ROOM</span>
  <h1 id="waitingTitle" style="margin:16px 0">Waiting for the quiz to start…</h1>
  <p id="waitingMessage">Stay on this page. The host will start the quiz for everyone.</p>
  <div id="countdownNumber" style="font-size:100px;line-height:1.2;font-weight:800;color:var(--purple);margin:18px 0"><%= quizState === 'countdown' ? '10' : '—' %></div>
  <p class="muted">You’ll start automatically when the countdown ends.</p>
</section>
<script src="/socket.io/socket.io.js"></script>
<script>
(()=>{const socket=io();const title=document.getElementById('waitingTitle'),msg=document.getElementById('waitingMessage'),number=document.getElementById('countdownNumber');let startAt=<%- JSON.stringify(quizStartAt) %>,state=<%- JSON.stringify(quizState) %>,redirecting=false;
function update(s){state=s.state;startAt=s.startAt;if(state==='started'){if(!redirecting){redirecting=true;location.href='/play'}return}if(state==='countdown'){title.textContent='The quiz starts in…';msg.textContent='Get ready! Everyone starts together.'}else{title.textContent='Waiting for the quiz to start…';msg.textContent='Stay on this page. The host will start the quiz for everyone.'}}
socket.on('quiz-state',update);function tick(){if(state==='countdown'&&startAt){const left=Math.max(0,Math.ceil((startAt-Date.now())/1000));number.textContent=left;if(left<=0){title.textContent='Here we go!';number.textContent='0';setTimeout(()=>{if(!redirecting){redirecting=true;location.href='/play'}},150)}}}setInterval(tick,100);tick();})();
</script>
<% } else if (quizState === 'finished') { %>
<section class="question-card waiting-card" style="text-align:center;max-width:680px;margin:55px auto;padding:45px 30px"><span class="eyebrow">QUIZ COMPLETE</span><h1>That’s the end!</h1><p>See your final score and ranking.</p><a class="btn btn-primary" href="/result">View my result</a></section>
<% } else if (!question) { %>
<section class="question-card waiting-card" style="text-align:center;max-width:680px;margin:55px auto;padding:45px 30px"><span class="eyebrow">PLEASE WAIT</span><h1><%= alreadyAnswered ? 'Answer submitted!' : 'Next question is coming…' %></h1><p><%= alreadyAnswered ? 'Your answer is saved. Everyone moves on together.' : 'The previous question has closed. The next one will appear for everyone at the same time.' %></p><div style="font-size:60px;font-weight:800;color:var(--purple)" id="waitCountdown">1</div></section>
<script src="/socket.io/socket.io.js"></script><script>(()=>{const s=io();s.on('quiz-state',()=>location.reload());setTimeout(()=>location.reload(),800);})();</script>
<% } else { %>
<section class="quiz-top"><div><span class="eyebrow">PLAYER · <%= player.nickname %></span><h1>Question <%= index %> <small>/ <%= total %></small></h1></div><div class="timer-pill">◷ <strong id="timer">14</strong><span>sec</span></div></section>
<div class="progress"><span style="width:<%= Math.round((index-1)/total*100) %>%"></span></div>
<section class="question-card"><div class="question-meta"><span class="type-pill"><%= question.type === 'tf' ? 'TRUE / FALSE' : 'Multiple choice' %></span><span><%= question.points %> pts + speed bonus</span></div><h2><%= question.text %></h2><form id="answerForm" action="/answer" method="post"><input type="hidden" name="questionId" value="<%= question.id %>"><input type="hidden" id="elapsedSeconds" name="elapsedSeconds" value="0"><div class="answer-grid <%= question.type === 'tf' ? 'tf-grid' : '' %>"><% question.options.forEach((option, i) => { %><label class="answer-option"><input type="radio" name="answer" value="<%= option %>" required><span class="letter"><%= String.fromCharCode(65+i) %></span><span><%= option %></span><span class="radio-dot"></span></label><% }) %></div><button class="btn btn-primary full submit-answer" type="submit">Submit my answer →</button></form></section>
<script src="/socket.io/socket.io.js"></script><script>
(()=>{const endsAt=<%- JSON.stringify(questionEndsAt) %>,startedAt=<%- JSON.stringify(questionStartedAt) %>,timer=document.getElementById('timer'),hidden=document.getElementById('elapsedSeconds'),form=document.getElementById('answerForm');let submitted=false;function tick(){const ms=Math.max(0,endsAt-Date.now()),remaining=Math.ceil(ms/1000);timer.textContent=remaining;timer.closest('.timer-pill').classList.toggle('urgent',remaining<=5);hidden.value=Math.min(14,Math.max(0,(Date.now()-startedAt)/1000)).toFixed(2);if(ms<=0&&!submitted){submitted=true;form.querySelectorAll('input[type=radio]').forEach(x=>x.disabled=true);if(!form.querySelector('input[name=answer]:checked')){const x=document.createElement('input');x.type='hidden';x.name='answer';x.value='';form.appendChild(x)}form.submit()}}setInterval(tick,100);tick();form.addEventListener('submit',()=>{form.querySelectorAll('button').forEach(b=>b.disabled=true)});const socket=io();socket.on('quiz-state',s=>{if(s.state==='countdown'||s.state==='finished'||s.phase!=='question'||s.questionIndex!==<%= index - 1 %>){location.href='/play'}});})();
</script>
<% } %>
<%- include('partials/foot') %>
