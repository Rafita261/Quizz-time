<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= settings.title %> · Presentation</title><link rel="stylesheet" href="/style.css"><style>
body{background:#101326;color:#f8f9ff}.presentation{max-width:1200px;margin:4vh auto;padding:24px}.presentation-head{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:28px}.presentation h1{font-size:clamp(30px,4vw,54px);margin:8px 0}.presentation .muted{color:#aab0ca}.presentation-card{background:#1b2039;border:1px solid #333957;border-radius:22px;padding:clamp(22px,4vw,44px);margin-bottom:20px}.presentation-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:20px}.answer-row{display:grid;grid-template-columns:minmax(100px,1fr) 3fr 50px;gap:12px;align-items:center;margin:18px 0}.bar{height:14px;border-radius:99px;background:#303753;overflow:hidden}.bar span{display:block;height:100%;background:#9a7bff;border-radius:99px}.rank-row{display:flex;align-items:center;gap:14px;padding:13px 0;border-bottom:1px solid #333957}.rank-row:last-child{border-bottom:0}.rank{font-weight:800;color:#bba8ff;width:34px}.rank-score{margin-left:auto;font-weight:800}.correct{color:#65e3b0}.big-wait{font-size:clamp(22px,3vw,36px);font-weight:750}.status-pill{background:#303753;padding:8px 12px;border-radius:99px;color:#ddd7ff;font-size:13px}.empty-state{padding:35px 0;text-align:center;color:#aab0ca}@media(max-width:800px){.presentation-grid{grid-template-columns:1fr}.presentation-head{align-items:flex-start;flex-direction:column}}
</style></head><body><main class="presentation">
<header class="presentation-head"><div><span class="eyebrow">LIVE PRESENTATION</span><h1><%= settings.title %></h1><p class="muted">Results update independently from the players’ question timer.</p></div><span class="status-pill" id="liveStatus">Connecting…</span></header>
<section class="presentation-card" id="mainPanel"><div class="empty-state">Waiting for the host to start the quiz…</div></section>
<div class="presentation-grid"><section class="presentation-card"><span class="eyebrow">ANSWER DISTRIBUTION</span><h2 id="distributionTitle">No completed question yet</h2><div id="distribution"><div class="empty-state">Results will appear here after a question closes.</div></div></section><section class="presentation-card"><span class="eyebrow">LIVE LEADERBOARD</span><h2>Current ranking</h2><div id="ranking"><div class="empty-state">Waiting for players…</div></div></section></div>
</main><script src="/socket.io/socket.io.js"></script><script>
(()=>{const socket=io();let latest=null;const $=id=>document.getElementById(id);function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function render(d){latest=d;const now=Date.now();$('liveStatus').textContent=d.state==='countdown'?'Starting soon':d.state==='finished'?'Quiz finished':d.state==='started'?'Question '+(d.questionIndex+1)+' in progress':'Waiting for host';
const showResults=d.questionText && d.resultsUntil && now<d.resultsUntil;
if(showResults){const remaining=Math.max(0,Math.ceil((d.resultsUntil-now)/1000));$('mainPanel').innerHTML='<span class="eyebrow">QUESTION '+d.questionNumber+' · RESULTS</span><h1>'+esc(d.questionText)+'</h1><p class="big-wait">Results · '+remaining+'s</p>'+(d.correctAnswer?'<p class="correct">Correct answer: <strong>'+esc(d.correctAnswer)+'</strong></p>':'');$('distributionTitle').textContent='Question '+d.questionNumber+' results';const max=Math.max(1,...d.distribution.map(x=>x.count));$('distribution').innerHTML=d.distribution.map(x=>'<div class="answer-row"><strong>'+esc(x.option)+'</strong><div class="bar"><span style="width:'+(x.count/max*100)+'%"></span></div><span>'+x.count+'</span></div>').join('')||'<div class="empty-state">No answers recorded.</div>';
}else if(d.state==='countdown'){$('mainPanel').innerHTML='<div class="empty-state"><span class="eyebrow">GET READY</span><h1>Quiz starts in…</h1><p class="big-wait" id="startTimer">—</p></div>'}else if(d.state==='finished'){$('mainPanel').innerHTML='<span class="eyebrow">QUIZ COMPLETE</span><h1>That’s a wrap!</h1><p class="big-wait">Final leaderboard is below.</p>'}else if(d.state==='started'){$('mainPanel').innerHTML='<span class="eyebrow">QUESTION '+(d.questionIndex+1)+' OF '+d.total+'</span><h1>Players are answering…</h1><p class="big-wait" id="playerTimer">'+Math.max(0,Math.ceil((d.questionEndsAt-now)/1000))+' seconds remaining</p><p class="muted">The next question is not shown on this screen.</p>'}else{$('mainPanel').innerHTML='<div class="empty-state"><span class="eyebrow">LIVE QUIZ</span><h1>Waiting for the host…</h1><p>Results and rankings will appear here.</p></div>'}
$('ranking').innerHTML=d.ranking.length?d.ranking.slice(0,10).map(p=>'<div class="rank-row"><span class="rank">#'+p.rank+'</span><strong>'+esc(p.nickname)+'</strong><span class="rank-score">'+p.score+' pts</span></div>').join(''):'<div class="empty-state">Waiting for players…</div>';
}
async function refresh(){try{const r=await fetch('/presentation-data',{cache:'no-store'});render(await r.json())}catch(e){}}socket.on('quiz-state',refresh);setInterval(refresh,400);refresh();
})();</script></body></html>
