<%- include('partials/head', {settings}) %>
<section class="page-heading"><span class="eyebrow">THE CHAMPIONS</span><h1>Leaderboard <span>🏆</span></h1><p>The top scores in the game.</p></section>
<section class="leaderboard"><div class="leader-head"><span>#</span><span>Nickname</span><span>Correct answers</span><span>Score</span></div><% if (!players.length) { %><div class="empty-state">No players yet. <a href="/join">Be the first!</a></div><% } %><% players.forEach((p, i) => { %><div class="leader-row <%= p.id === currentId ? 'you' : '' %>"><span class="rank"><%= i===0?'🥇':i===1?'🥈':i===2?'🥉':i+1 %></span><span class="player-name"><span class="mini-avatar"><%= p.nickname.slice(0,1).toUpperCase() %></span><%= p.nickname %><% if (p.id===currentId) { %><em>You</em><% } %></span><span><%= p.answers.filter(a=>a.correct).length %>/<%= p.answers.length %></span><strong><%= p.score %> pts</strong></div><% }) %></section><div class="center"><a class="btn btn-primary" href="/join">Play now →</a></div>
<script src="/socket.io/socket.io.js"></script><script>const liveSocket=io();liveSocket.on("quiz-state",s=>{if(s.state==="countdown"||s.state==="started")location.href="/play"});</script>
<%- include('partials/foot') %>