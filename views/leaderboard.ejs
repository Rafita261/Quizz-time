<%- include('partials/head', {settings}) %>
<section class="page-heading"><span class="eyebrow">LES CHAMPIONS</span><h1>Le classement <span>🏆</span></h1><p>Les meilleurs scores de la partie.</p></section>
<section class="leaderboard"><div class="leader-head"><span>#</span><span>Pseudonyme</span><span>Réussite</span><span>Score</span></div><% if (!players.length) { %><div class="empty-state">Pas encore de joueurs. <a href="/join">Sois le premier !</a></div><% } %><% players.forEach((p, i) => { %><div class="leader-row <%= p.id === currentId ? 'you' : '' %>"><span class="rank"><%= i===0?'🥇':i===1?'🥈':i===2?'🥉':i+1 %></span><span class="player-name"><span class="mini-avatar"><%= p.nickname.slice(0,1).toUpperCase() %></span><%= p.nickname %><% if (p.id===currentId) { %><em>Toi</em><% } %></span><span><%= p.answers.filter(a=>a.correct).length %>/<%= p.answers.length %></span><strong><%= p.score %> pts</strong></div><% }) %></section><div class="center"><a class="btn btn-primary" href="/join">Jouer à mon tour →</a></div>
<%- include('partials/foot') %>