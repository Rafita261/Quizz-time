<%- include('partials/head', {settings}) %>
<section class="join-layout"><div class="join-intro"><span class="eyebrow">WELCOME TO THE GAME</span><h1>It’s your<br><span>turn to play!</span></h1><p><%= settings.lobbyMessage || 'Scan the QR code or enter your nickname to join.' %></p><div class="privacy-note">☺ No account. Just a nickname!</div></div><div class="join-card"><div class="qr-wrap"><img src="<%= qr %>" alt="QR code to join the quiz"><p>Scan to open this page</p></div><div class="join-form"><div class="avatar">♙</div><h2>Join the game</h2><p>Choose a nickname</p><% if (error) { %><div class="alert"><%= error %></div><% } %><form method="post" action="/join"><label for="nickname">Your nickname</label><input id="nickname" name="nickname" placeholder="e.g. Nova, QuizMaster…" minlength="2" maxlength="18" required autofocus><button class="btn btn-primary full" type="submit">Join the quiz →</button></form></div></div></section>
<%- include('partials/foot') %>