<%- include('partials/head', {settings}) %>
<section class="admin-heading"><div><span class="eyebrow">CONTROL CENTER</span><h1>Quiz <span>quiz</span></h1><p>Manage questions, timing, points, and access to the game.</p><p><a href="/presentation" target="_blank" rel="noopener">Open presentation screen ↗</a></p></div><form method="post" action="/admin/logout"><button class="btn btn-outline">Log out</button></form></section>
<section class="admin-stats"><div class="stat-card"><small>Questions</small><strong><%= questions.length %></strong></div><div class="stat-card"><small>Players</small><strong><%= players.length %></strong></div><div class="stat-card"><small>Game status</small><strong class="state-text"><%= settings.quizOpen ? 'Open' : 'Closed' %></strong></div></section>
<section class="panel" style="display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap">
 <div><span class="eyebrow">LIVE CONTROL</span><h2 style="margin:5px 0 8px">Quiz controls</h2><p class="muted" style="margin:0">Questions last 14 seconds, followed by a 1-second break. Presentation results run independently for 5 seconds.</p>
 <% if (quizState === 'lobby') { %><p class="muted">Status: waiting</p><% } else if (quizState === 'countdown') { %><p style="color:var(--purple);font-weight:700">Countdown in progress…</p><% } else if (quizState === 'finished') { %><p style="color:var(--green);font-weight:700">Quiz finished</p><% } else { %><p style="color:var(--green);font-weight:700">Quiz running</p><% } %></div>
 <form method="post" action="/admin/start-quiz" onsubmit="return confirm('Restart the quiz from question 1? All player scores and answers will be reset.')"><button class="btn btn-primary" type="submit"><%= quizState === 'lobby' ? '▶ Start quiz (10 sec)' : '↻ Restart quiz (10 sec)' %></button></form>
</section>
<section class="panel"><div class="panel-title"><div><span class="eyebrow">LIVE RESULTS</span><h2 id="adminResultsTitle">Latest question results</h2></div><a href="/presentation" target="_blank" rel="noopener">Open presentation screen ↗</a></div><div id="adminDistribution" class="muted">Results will appear here when a question closes.</div></section>
<div class="admin-columns"><section class="panel"><div class="panel-title"><div><span class="eyebrow">CONTENT</span><h2>Add a question</h2></div><span class="icon-box purple">＋</span></div><form method="post" action="/admin/question" class="stack-form"><label>Question text</label><textarea name="text" rows="3" required placeholder="Type your question here…"></textarea><div class="form-two"><div><label>Type</label><select name="type" id="qType"><option value="qcm">Multiple choice</option><option value="tf">True / False</option></select></div><div><label>Question duration</label><input type="text" value="14 seconds (fixed)" disabled><input type="hidden" name="seconds" value="14"></div></div><label>Answer choices (one per line, for multiple choice)</label><textarea name="options" id="options" rows="4">Answer A
Answer B
Answer C
Answer D</textarea><label>Correct answer (must match one of the choices)</label><input name="answer" id="answer" placeholder="e.g. Answer A" required><div class="form-two"><div><label>Base points</label><input type="number" name="points" value="10" min="1" max="1000"></div><label class="checkline"><input type="checkbox" name="active" checked> Question active</label></div><button class="btn btn-primary full">＋ Add question</button></form></section>
<section class="panel"><div class="panel-title"><div><span class="eyebrow">SETTINGS</span><h2>Game rules</h2></div><span class="icon-box blue">⚙</span></div><form method="post" action="/admin/settings" class="stack-form"><label>Quiz name</label><input name="title" value="<%= settings.title %>" required><label>Welcome message</label><textarea name="lobbyMessage" rows="2"><%= settings.lobbyMessage %></textarea><div class="form-two"><div><label>Maximum speed bonus</label><input type="number" name="bonusMax" min="0" max="50" value="<%= settings.bonusMax %>"></div><div class="check-stack"><label class="checkline"><input type="checkbox" name="timeBonus" <%= settings.timeBonus?'checked':'' %>> Speed bonus</label><label class="checkline"><input type="checkbox" name="showCorrectAnswer" <%= settings.showCorrectAnswer?'checked':'' %>> Show correct answer (setting)</label><label class="checkline"><input type="checkbox" name="quizOpen" <%= settings.quizOpen?'checked':'' %>> Accept players</label></div></div><button class="btn btn-primary full">Save settings</button></form><div class="scoring-note"><b>Scoring</b><p>Correct answer = base points + a bonus based on time remaining. Incorrect answer or timeout = 0 points.</p></div></section></div>
<section class="panel question-list-panel"><div class="panel-title"><div><span class="eyebrow">QUESTION BANK</span><h2>Existing questions</h2></div><span class="muted"><%= questions.length %> total</span></div><div class="table-wrap"><table><thead><tr><th>#</th><th>Question</th><th>Type</th><th>Time</th><th>Points</th><th>Status</th><th></th></tr></thead><tbody><% questions.forEach(q=>{ %><tr><td><%= q.id %></td><td class="question-cell"><%= q.text %><small>Answer: <%= q.answer %></small></td><td><span class="type-pill"><%= q.type==='tf'?'True/False':'Multiple choice' %></span></td><td>14 s</td><td><%= q.points %></td><td><span class="status <%= q.active?'on':'off' %>"><%= q.active?'Active':'Inactive' %></span></td><td><form method="post" action="/admin/question/<%= q.id %>/delete" onsubmit="return confirm('Delete this question?')"><button class="delete-btn" title="Delete">✕</button></form></td></tr><% }) %></tbody></table></div></section>
<section class="panel roster"><div class="panel-title"><div><span class="eyebrow">PLAYERS</span><h2>Current leaderboard</h2></div><form method="post" action="/admin/reset-scores" onsubmit="return confirm('Delete all players and scores?')"><button class="btn btn-outline btn-small">Reset scores</button></form></div><div class="roster-list" id="adminRanking"><% if(!players.length) { %><p class="muted">No players yet.</p><% } else { %><% players.slice(0,10).forEach((p,i)=>{ %><div><b><%= i+1 %>.</b><span class="mini-avatar"><%= p.nickname.slice(0,1).toUpperCase() %></span><span><%= p.nickname %></span><strong><%= p.score %> pts</strong></div><% }) %><% } %></div></section>
<script src="/socket.io/socket.io.js"></script><script>
document.getElementById('qType').addEventListener('change',e=>{const tf=e.target.value==='tf';document.getElementById('options').value=tf?'True\nFalse':'Answer A\nAnswer B\nAnswer C\nAnswer D';document.getElementById('answer').value=tf?'True':'';document.getElementById('options').readOnly=tf;});
function escapeHtml(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
async function refreshAdminResults(){try{const d=await(await fetch('/presentation-data',{cache:'no-store'})).json();const box=document.getElementById('adminDistribution');if(d.questionText){document.getElementById('adminResultsTitle').textContent='Question '+d.questionNumber+' · '+d.questionText;box.innerHTML=d.distribution.map(x=>'<div style="display:grid;grid-template-columns:minmax(120px,1fr) 3fr 45px;gap:12px;align-items:center;margin:12px 0"><strong>'+escapeHtml(x.option)+'</strong><div style="height:10px;background:#edf0f6;border-radius:20px;overflow:hidden"><span style="display:block;height:100%;width:'+(x.count/Math.max(1,...d.distribution.map(v=>v.count))*100)+'%;background:var(--purple)"></span></div><span>'+x.count+'</span></div>').join('')+(d.correctAnswer?'<p><b>Correct answer:</b> '+escapeHtml(d.correctAnswer)+'</p>':'')}const ranking=document.getElementById('adminRanking');if(ranking)ranking.innerHTML=d.ranking.length?d.ranking.slice(0,10).map(p=>'<div><b>'+p.rank+'.</b><span class="mini-avatar">'+escapeHtml(String(p.nickname).slice(0,1).toUpperCase())+'</span><span>'+escapeHtml(p.nickname)+'</span><strong>'+p.score+' pts</strong></div>').join(''):'<p class="muted">No players yet.</p>'}catch(e){}}
const adminSocket=io();adminSocket.on('quiz-state',refreshAdminResults);setInterval(refreshAdminResults,1000);refreshAdminResults();
</script>
<%- include('partials/foot') %>