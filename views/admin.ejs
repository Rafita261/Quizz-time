<%- include('partials/head', {settings}) %>
<section class="admin-heading"><div><span class="eyebrow">CONTROL CENTER</span><h1>Quiz <span>quiz</span></h1><p>Manage questions, timing, points, and access to the game.</p></div><form method="post" action="/admin/logout"><button class="btn btn-outline">Log out</button></form></section>
<section class="admin-stats"><div class="stat-card"><small>Questions</small><strong><%= questions.length %></strong></div><div class="stat-card"><small>Players</small><strong><%= players.length %></strong></div><div class="stat-card"><small>Game status</small><strong class="state-text"><%= settings.quizOpen ? 'Open' : 'Closed' %></strong></div></section>
<section class="panel" style="display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap">
 <div><span class="eyebrow">GROUP START</span><h2 style="margin:5px 0 8px">Start the quiz</h2><p class="muted" style="margin:0">All players will see the same 10-second countdown.</p>
 <% if (quizState === 'lobby') { %><p class="muted">Status: waiting</p><% } else if (quizState === 'countdown') { %><p style="color:var(--purple);font-weight:700">Countdown in progress…</p><% } else { %><p style="color:var(--green);font-weight:700">Quiz started</p><% } %></div>
 <form method="post" action="/admin/start-quiz"><button class="btn btn-primary" type="submit" <%= quizState !== 'lobby' ? 'disabled' : '' %>><%= quizState === 'lobby' ? '▶ Start quiz (10 sec)' : quizState === 'countdown' ? 'Starting soon…' : 'Quiz already started' %></button></form>
</section>
<div class="admin-columns"><section class="panel"><div class="panel-title"><div><span class="eyebrow">CONTENT</span><h2>Add a question</h2></div><span class="icon-box purple">＋</span></div><form method="post" action="/admin/question" class="stack-form"><label>Question text</label><textarea name="text" rows="3" required placeholder="Type your question here…"></textarea><div class="form-two"><div><label>Type</label><select name="type" id="qType"><option value="qcm">Multiple choice</option><option value="tf">True / False</option></select></div><div><label>Duration (seconds)</label><input type="number" name="seconds" value="30" min="5" max="300" required></div></div><label>Answer choices (one per line, for multiple choice)</label><textarea name="options" id="options" rows="4">Answer A
Answer B
Answer C
Answer D</textarea><label>Correct answer (must match one of the choices)</label><input name="answer" id="answer" placeholder="e.g. Answer A" required><div class="form-two"><div><label>Base points</label><input type="number" name="points" value="10" min="1" max="1000"></div><label class="checkline"><input type="checkbox" name="active" checked> Question active</label></div><button class="btn btn-primary full">＋ Add question</button></form></section>
<section class="panel"><div class="panel-title"><div><span class="eyebrow">SETTINGS</span><h2>Game rules</h2></div><span class="icon-box blue">⚙</span></div><form method="post" action="/admin/settings" class="stack-form"><label>Quiz name</label><input name="title" value="<%= settings.title %>" required><label>Welcome message</label><textarea name="lobbyMessage" rows="2"><%= settings.lobbyMessage %></textarea><div class="form-two"><div><label>Maximum speed bonus</label><input type="number" name="bonusMax" min="0" max="50" value="<%= settings.bonusMax %>"></div><div class="check-stack"><label class="checkline"><input type="checkbox" name="timeBonus" <%= settings.timeBonus?'checked':'' %>> Speed bonus</label><label class="checkline"><input type="checkbox" name="showCorrectAnswer" <%= settings.showCorrectAnswer?'checked':'' %>> Show correct answer (setting)</label><label class="checkline"><input type="checkbox" name="quizOpen" <%= settings.quizOpen?'checked':'' %>> Accept players</label></div></div><button class="btn btn-primary full">Save settings</button></form><div class="scoring-note"><b>Scoring</b><p>Correct answer = base points + a bonus based on time remaining. Incorrect answer or timeout = 0 points.</p></div></section></div>
<section class="panel question-list-panel"><div class="panel-title"><div><span class="eyebrow">QUESTION BANK</span><h2>Existing questions</h2></div><span class="muted"><%= questions.length %> total</span></div><div class="table-wrap"><table><thead><tr><th>#</th><th>Question</th><th>Type</th><th>Time</th><th>Points</th><th>Status</th><th></th></tr></thead><tbody><% questions.forEach(q=>{ %><tr><td><%= q.id %></td><td class="question-cell"><%= q.text %><small>Answer: <%= q.answer %></small></td><td><span class="type-pill"><%= q.type==='tf'?'True/False':'Multiple choice' %></span></td><td><%= q.seconds %> s</td><td><%= q.points %></td><td><span class="status <%= q.active?'on':'off' %>"><%= q.active?'Active':'Inactive' %></span></td><td><form method="post" action="/admin/question/<%= q.id %>/delete" onsubmit="return confirm('Delete this question?')"><button class="delete-btn" title="Delete">✕</button></form></td></tr><% }) %></tbody></table></div></section>
<section class="panel roster"><div class="panel-title"><div><span class="eyebrow">PLAYERS</span><h2>Current leaderboard</h2></div><form method="post" action="/admin/reset-scores" onsubmit="return confirm('Delete all players and scores?')"><button class="btn btn-outline btn-small">Reset scores</button></form></div><% if(!players.length) { %><p class="muted">No players yet.</p><% } else { %><div class="roster-list"><% players.slice(0,10).forEach((p,i)=>{ %><div><b><%= i+1 %>.</b><span class="mini-avatar"><%= p.nickname.slice(0,1).toUpperCase() %></span><span><%= p.nickname %></span><strong><%= p.score %> pts</strong></div><% }) %></div><% } %></section>
<script>document.getElementById('qType').addEventListener('change',e=>{const tf=e.target.value==='tf';document.getElementById('options').value=tf?'True\\nFalse':'Answer A\\nAnswer B\\nAnswer C\\nAnswer D';document.getElementById('answer').value=tf?'True':'';document.getElementById('options').readOnly=tf;});</script>
<%- include('partials/foot') %>