<%- include('partials/head', {settings}) %>
<section class="admin-heading"><div><span class="eyebrow">CENTRE DE CONTRÔLE</span><h1>Gestion du <span>quiz</span></h1><p>Configure les questions, le temps, les points et l’accès à la partie.</p></div><form method="post" action="/admin/logout"><button class="btn btn-outline">Déconnexion</button></form></section>
<section class="admin-stats"><div class="stat-card"><small>Questions</small><strong><%= questions.length %></strong></div><div class="stat-card"><small>Joueurs</small><strong><%= players.length %></strong></div><div class="stat-card"><small>État de la partie</small><strong class="state-text"><%= settings.quizOpen ? 'Ouverte' : 'Fermée' %></strong></div></section>
<div class="admin-columns"><section class="panel"><div class="panel-title"><div><span class="eyebrow">CONTENU</span><h2>Ajouter une question</h2></div><span class="icon-box purple">＋</span></div><form method="post" action="/admin/question" class="stack-form"><label>Énoncé</label><textarea name="text" rows="3" required placeholder="Écris ta question ici…"></textarea><div class="form-two"><div><label>Type</label><select name="type" id="qType"><option value="qcm">QCM</option><option value="tf">Vrai / Faux</option></select></div><div><label>Durée (secondes)</label><input type="number" name="seconds" value="30" min="5" max="300" required></div></div><label>Choix (un par ligne, pour un QCM)</label><textarea name="options" id="options" rows="4">Réponse A
Réponse B
Réponse C
Réponse D</textarea><label>Bonne réponse (doit correspondre à un choix)</label><input name="answer" id="answer" placeholder="Ex. Réponse A" required><div class="form-two"><div><label>Points de base</label><input type="number" name="points" value="10" min="1" max="1000"></div><label class="checkline"><input type="checkbox" name="active" checked> Question active</label></div><button class="btn btn-primary full">＋ Ajouter la question</button></form></section>
<section class="panel"><div class="panel-title"><div><span class="eyebrow">PARAMÈTRES</span><h2>Règles de la partie</h2></div><span class="icon-box blue">⚙</span></div><form method="post" action="/admin/settings" class="stack-form"><label>Nom du quiz</label><input name="title" value="<%= settings.title %>" required><label>Message d’accueil</label><textarea name="lobbyMessage" rows="2"><%= settings.lobbyMessage %></textarea><div class="form-two"><div><label>Bonus vitesse maximum</label><input type="number" name="bonusMax" min="0" max="50" value="<%= settings.bonusMax %>"></div><div class="check-stack"><label class="checkline"><input type="checkbox" name="timeBonus" <%= settings.timeBonus?'checked':'' %>> Bonus de rapidité</label><label class="checkline"><input type="checkbox" name="showCorrectAnswer" <%= settings.showCorrectAnswer?'checked':'' %>> Afficher la correction (réglage)</label><label class="checkline"><input type="checkbox" name="quizOpen" <%= settings.quizOpen?'checked':'' %>> Accepter les joueurs</label></div></div><button class="btn btn-primary full">Enregistrer les paramètres</button></form><div class="scoring-note"><b>Calcul du score</b><p>Bonne réponse = points de base + bonus proportionnel au temps restant. Mauvaise réponse ou expiration = 0 point.</p></div></section></div>
<section class="panel question-list-panel"><div class="panel-title"><div><span class="eyebrow">BANQUE DE QUESTIONS</span><h2>Questions existantes</h2></div><span class="muted"><%= questions.length %> au total</span></div><div class="table-wrap"><table><thead><tr><th>#</th><th>Question</th><th>Type</th><th>Temps</th><th>Points</th><th>État</th><th></th></tr></thead><tbody><% questions.forEach(q=>{ %><tr><td><%= q.id %></td><td class="question-cell"><%= q.text %><small>Réponse : <%= q.answer %></small></td><td><span class="type-pill"><%= q.type==='tf'?'Vrai/Faux':'QCM' %></span></td><td><%= q.seconds %> s</td><td><%= q.points %></td><td><span class="status <%= q.active?'on':'off' %>"><%= q.active?'Active':'Inactive' %></span></td><td><form method="post" action="/admin/question/<%= q.id %>/delete" onsubmit="return confirm('Supprimer cette question ?')"><button class="delete-btn" title="Supprimer">✕</button></form></td></tr><% }) %></tbody></table></div></section>
<section class="panel roster"><div class="panel-title"><div><span class="eyebrow">JOUEURS</span><h2>Classement actuel</h2></div><form method="post" action="/admin/reset-scores" onsubmit="return confirm('Effacer tous les joueurs et scores ?')"><button class="btn btn-outline btn-small">Réinitialiser les scores</button></form></div><% if(!players.length) { %><p class="muted">Aucun joueur pour le moment.</p><% } else { %><div class="roster-list"><% players.slice(0,10).forEach((p,i)=>{ %><div><b><%= i+1 %>.</b><span class="mini-avatar"><%= p.nickname.slice(0,1).toUpperCase() %></span><span><%= p.nickname %></span><strong><%= p.score %> pts</strong></div><% }) %></div><% } %></section>
<script>document.getElementById('qType').addEventListener('change',e=>{const tf=e.target.value==='tf';document.getElementById('options').value=tf?'True\\nFalse':'Réponse A\\nRéponse B\\nRéponse C\\nRéponse D';document.getElementById('answer').value=tf?'True':'';document.getElementById('options').readOnly=tf;});</script>
<%- include('partials/foot') %>